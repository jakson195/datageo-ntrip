# Copie para .env.local e preencha os valores. Nunca commite chaves reais.

# RTKdata Shop API (portal revendedor)
# sandbox = chave rtk_test_* | production = chave rtk_live_*
RTK_API_MODE=sandbox
RTK_API_BASE_URL=https://rtkdata-reseller-1.onrender.com/api/v1
RTK_API_KEY_TEST=
RTK_API_KEY_PRODUCTION=
RTK_DEFAULT_COUNTRY=BR
RTK_DEFAULT_MAX_CONNECTIONS=1

# Mercado Pago (PIX, cartão, assinatura recorrente)
MERCADOPAGO_ACCESS_TOKEN=
# Chave pública (Checkout Bricks — formulário de cartão na página)
MERCADOPAGO_PUBLIC_KEY=
NEXT_PUBLIC_MERCADOPAGO_PUBLIC_KEY=

# Stripe (cartão internacional / assinatura recorrente)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Cron jobs (Vercel)
CRON_SECRET=

# Admin API
ADMIN_SECRET=

# Notificações de billing (webhook opcional — Zapier, n8n, Resend relay)
BILLING_NOTIFICATION_WEBHOOK_URL=

# App URL pública (webhooks MP/Stripe) — produção:
# NEXT_PUBLIC_APP_URL=https://datageontrip.com.br
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Webhook MP (configurar no painel):
# https://datageontrip.com.br/api/webhooks/mercadopago

# NTRIP caster padrão
NTRIP_SERVER=sa.geodnet.com
NTRIP_PORT=2101
NTRIP_MOUNTPOINT=AUTO

# Aerofotogrametria — NodeODM / OpenDroneMap (local: docker compose up nodeodm -d)
PHOTOGRAMMETRY_ODM_URL=http://localhost:3002
# PHOTOGRAMMETRY_ODM_TOKEN=

# Assistente IA CAD (OpenAI)
OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o-mini

# API SICAR Temas do Imóvel (ConectaGov/SERPRO) — importação CAD por código CAR
# Produção: https://apigateway.conectagov.estaleiro.serpro.gov.br/api-sicar-tema/v1/
# Homologação: SICAR_API_ENV=homolog
# Opção A — token Bearer fixo:
# SICAR_API_BEARER_TOKEN=
# Opção B — OAuth client credentials:
# SICAR_CLIENT_ID=
# SICAR_CLIENT_SECRET=
# SICAR_API_ENV=production
