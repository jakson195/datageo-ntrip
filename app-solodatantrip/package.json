{
  "name": "datageo-ntrip",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "node scripts/ensure-database-env.mjs && node scripts/ensure-plans.mjs && next dev -p 3000",
    "build": "node scripts/ensure-database-env.mjs && prisma generate && node scripts/ensure-plans.mjs && next build",
    "start": "next start -p 3000",
    "lint": "eslint",
    "postinstall": "prisma generate",
    "db:validate": "npx tsx scripts/validate-database-env.ts",
    "db:migrate": "prisma migrate dev",
    "db:migrate:deploy": "prisma migrate deploy",
    "db:seed": "npx tsx prisma/seed.ts",
    "db:reset-signups": "npx tsx scripts/reset-signups.ts",
    "test:billing-pix": "npx tsx scripts/test-billing-pix.ts",
    "db:studio": "prisma studio",
    "vercel:setup": "node scripts/setup-vercel.mjs"
  },
  "dependencies": {
    "@mapbox/shp-write": "^0.4.3",
    "@mercadopago/sdk-react": "^1.0.7",
    "@node-projects/acad-ts": "^2.3.0",
    "@prisma/client": "^6.19.0",
    "@turf/turf": "^7.3.5",
    "bcryptjs": "^3.0.3",
    "d3-contour": "^4.0.2",
    "docx": "^9.7.1",
    "exifr": "^7.1.3",
    "fflate": "^0.8.3",
    "geotiff": "^3.0.5",
    "jspdf": "^4.2.1",
    "jspdf-autotable": "^5.0.8",
    "mathjs": "^15.2.0",
    "mercadopago": "^3.1.0",
    "next": "16.2.6",
    "next-intl": "^4.13.0",
    "openai": "^6.45.0",
    "proj4": "^2.20.9",
    "qrcode": "^1.5.4",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "shpjs": "^6.2.0",
    "stripe": "^22.2.0",
    "three": "^0.185.1",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^20",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/shpjs": "^3.4.7",
    "@types/three": "^0.185.1",
    "dotenv": "^17.4.2",
    "eslint": "^9",
    "eslint-config-next": "16.2.6",
    "prisma": "^6.19.0",
    "server-only": "^0.0.1",
    "tailwindcss": "^4",
    "tsx": "^4.22.4",
    "typescript": "^5"
  }
}
